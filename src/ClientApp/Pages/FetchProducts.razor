@page "/fetchproducts"
@using System.Text.Json
@inject HttpClient Http
<h3>Product List</h3>
<ul>
   @if (errorMessage != null)
    {
        <li>@errorMessage</li>
    }
    else if (products != null)
    {
        foreach (var product in products)
        {
            <li>@product.Name - $@product.Price</li>
        }
    }
    else
    {
        <li>Loading...</li>
    }
</ul>
@code {
    private Product[]? products = null;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductsAsync();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            var response = await Http.GetAsync("/api/productlist");
            response.EnsureSuccessStatusCode();
            var json = await response.Content.ReadAsStringAsync();
            products = JsonSerializer.Deserialize<Product[]>(json) ?? Array.Empty<Product>();
        }
        catch (JsonException ex)
        {
            // The response arrived but was not valid JSON for Product[] — for example if the
            // back-end response structure changed unexpectedly. Caught separately so a
            // malformed payload shows a clear message instead of an unhandled exception.
            Console.WriteLine($"Error: {ex.Message}");
            errorMessage = "The product API returned malformed JSON.";
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            errorMessage = $"Unable to reach the product API: {ex.Message}";
        }
        catch (TaskCanceledException ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
            errorMessage = "The product API request timed out.";
        }
    }

    public class Product
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public double Price { get; set; }
        public int Stock { get; set; }
    }
}
